{
  "name": "taskbridge-api",
  "version": "1.0.0",
  "description": "TaskBridge Notification & Audit Service - B2B SaaS Collaboration Platform",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "saas",
    "b2b",
    "audit",
    "notifications",
    "multi-tenant"
  ],
  "author": "Vankayala Veera Venkata Rajashekhar",
  "license": "Proprietary",
  "dependencies": {
    "express": "^4.18.2",
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "pino": "^8.17.2",
    "pino-http": "^8.5.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.1.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
